<Window x:Class="ClockWidg.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClockWidg Tools"
        Width="440" Height="520" MinWidth="360" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClockWidg;component/Themes/WidgetTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="8" CornerRadius="12" Background="{StaticResource WidgetBgBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🕘" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Clock Tools" FontFamily="Segoe UI Semibold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Close_Click"/>
            </Grid>

            <!-- Tab strip -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="RbAlarms" Style="{StaticResource TabRadio}" Content="Alarms" IsChecked="True"/>
                <RadioButton x:Name="RbStopwatch" Style="{StaticResource TabRadio}" Content="Stopwatch"/>
                <RadioButton x:Name="RbTimer" Style="{StaticResource TabRadio}" Content="Timer"/>
            </StackPanel>

            <!-- ===================== Content ===================== -->
            <Grid Grid.Row="2">

                <!-- ALARMS -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbAlarms, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="+ Add Alarm" HorizontalAlignment="Left"
                            Margin="0,0,0,10" Click="AddAlarm_Click"/>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyAlarmsText" Text="No alarms yet. Click “Add Alarm”."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AlarmsList" ItemsSource="{Binding Alarms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Checked="AlarmChanged_Update" Unchecked="AlarmChanged_Update"/>
                                                    <TextBox Width="190" Height="28" Margin="10,0,0,0"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="✕" Width="28" Height="28" Margin="8,0,0,0"
                                                            Background="#5A2530" Tag="{Binding}" Click="DeleteAlarm_Click"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="28,10,0,0">
                                                    <ComboBox Width="62"
                                                              ItemsSource="{Binding HoursList, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              ItemStringFormat="{}{0:00}"
                                                              SelectedItem="{Binding Hour, Mode=TwoWay}"
                                                              SelectionChanged="AlarmChanged_Update"/>
                                                    <TextBlock Text=":" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="16" VerticalAlignment="Center" Margin="5,0"/>
                                                    <ComboBox Width="62"
                                                              ItemsSource="{Binding MinutesList, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              ItemStringFormat="{}{0:00}"
                                                              SelectedItem="{Binding Minute, Mode=TwoWay}"
                                                              SelectionChanged="AlarmChanged_Update"/>
                                                    <CheckBox Content="Repeat daily" Margin="18,0,0,0"
                                                              IsChecked="{Binding Repeat, Mode=TwoWay}"
                                                              Checked="AlarmChanged_Update" Unchecked="AlarmChanged_Update"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- STOPWATCH -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbStopwatch, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SwDisplay" Grid.Row="0" Text="00:00:00.00"
                               FontFamily="Consolas" FontSize="44" Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center" Margin="0,14,0,16"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button x:Name="SwStartStop" Content="Start" Width="90" Height="38" Margin="0,0,10,0"
                                Click="SwStartStop_Click"/>
                        <Button x:Name="SwLap" Content="Lap" Width="90" Height="38" Margin="0,0,10,0"
                                Click="SwLap_Click" IsEnabled="False"/>
                        <Button x:Name="SwReset" Content="Reset" Width="90" Height="38"
                                Click="SwReset_Click" IsEnabled="False"/>
                    </StackPanel>
                    <ListBox x:Name="SwLaps" Grid.Row="2" FontFamily="Consolas"/>
                </Grid>

                <!-- TIMER -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbTimer, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="TimerInputs" Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,14,0,10">
                        <ComboBox x:Name="TmHours" Width="64" ItemsSource="{Binding HoursList}" ItemStringFormat="{}{0:00}" SelectedIndex="0"/>
                        <TextBlock Text="h" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,12,0"/>
                        <ComboBox x:Name="TmMinutes" Width="64" ItemsSource="{Binding MinutesList}" ItemStringFormat="{}{0:00}" SelectedIndex="5"/>
                        <TextBlock Text="m" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,12,0"/>
                        <ComboBox x:Name="TmSeconds" Width="64" ItemsSource="{Binding MinutesList}" ItemStringFormat="{}{0:00}" SelectedIndex="0"/>
                        <TextBlock Text="s" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TmDisplay" Grid.Row="1" Text="00:05:00"
                               FontFamily="Consolas" FontSize="44" Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center" Margin="0,6,0,16"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="TmStartPause" Content="Start" Width="100" Height="38" Margin="0,0,10,0"
                                Click="TmStartPause_Click"/>
                        <Button x:Name="TmReset" Content="Reset" Width="100" Height="38"
                                Click="TmReset_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="TmDoneText" Grid.Row="3" Text="⏰  Time's up!"
                               FontFamily="Segoe UI Semibold" FontSize="22" Foreground="{StaticResource AccentBrush}"
                               TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
