<Window x:Class="ClockWidg.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClockWidg — Alarms · Stopwatch · Timer"
        Width="460" Height="540" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#141C28"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A3A52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38507A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#22304A"/>
                                <Setter Property="Foreground" Value="#6B7A93"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1622"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C7D3E6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Background="#141C28" BorderThickness="0" Margin="6">
        <!-- ===================== ALARMS ===================== -->
        <TabItem Header="Alarms">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Alarms" FontSize="18"
                               FontFamily="Segoe UI Semibold" Foreground="White" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="+ Add Alarm" Click="AddAlarm_Click"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyAlarmsText" Text="No alarms yet. Click “Add Alarm”."
                               Foreground="#6B7A93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AlarmsList" ItemsSource="{Binding Alarms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1B2432" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          Checked="AlarmChanged_Update" Unchecked="AlarmChanged_Update"/>
                                                <TextBox Width="200" Margin="8,0,0,0"
                                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Content="✕" Width="28" Height="24" Margin="8,0,0,0"
                                                        Background="#5A2530" Tag="{Binding}" Click="DeleteAlarm_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="26,8,0,0">
                                                <ComboBox Width="60"
                                                          ItemsSource="{Binding HoursList, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          ItemStringFormat="{}{0:00}"
                                                          SelectedItem="{Binding Hour, Mode=TwoWay}"
                                                          SelectionChanged="AlarmChanged_Update"/>
                                                <TextBlock Text=":" Foreground="White" FontSize="16"
                                                           VerticalAlignment="Center" Margin="4,0"/>
                                                <ComboBox Width="60"
                                                          ItemsSource="{Binding MinutesList, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          ItemStringFormat="{}{0:00}"
                                                          SelectedItem="{Binding Minute, Mode=TwoWay}"
                                                          SelectionChanged="AlarmChanged_Update"/>
                                                <CheckBox Content="Repeat daily" Margin="18,0,0,0"
                                                          IsChecked="{Binding Repeat, Mode=TwoWay}"
                                                          Checked="AlarmChanged_Update" Unchecked="AlarmChanged_Update"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===================== STOPWATCH ===================== -->
        <TabItem Header="Stopwatch">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SwDisplay" Grid.Row="0" Text="00:00:00.00"
                           FontFamily="Consolas" FontSize="46" Foreground="White"
                           TextAlignment="Center" Margin="0,20,0,16"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Button x:Name="SwStartStop" Content="Start" Width="90" Height="38" Margin="0,0,10,0"
                            Click="SwStartStop_Click"/>
                    <Button x:Name="SwLap" Content="Lap" Width="90" Height="38" Margin="0,0,10,0"
                            Click="SwLap_Click" IsEnabled="False"/>
                    <Button x:Name="SwReset" Content="Reset" Width="90" Height="38"
                            Click="SwReset_Click" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="SwLaps" Grid.Row="2" Background="#0F1622" Foreground="#C7D3E6"
                         BorderBrush="#2A3A52" BorderThickness="1" FontFamily="Consolas"/>
            </Grid>
        </TabItem>

        <!-- ===================== TIMER ===================== -->
        <TabItem Header="Timer">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="TimerInputs" Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,16,0,10">
                    <ComboBox x:Name="TmHours" Width="64" ItemsSource="{Binding HoursList}" ItemStringFormat="{}{0:00}" SelectedIndex="0"/>
                    <TextBlock Text="h" Foreground="#9BB4D8" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <ComboBox x:Name="TmMinutes" Width="64" ItemsSource="{Binding MinutesList}" ItemStringFormat="{}{0:00}" SelectedIndex="5"/>
                    <TextBlock Text="m" Foreground="#9BB4D8" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <ComboBox x:Name="TmSeconds" Width="64" ItemsSource="{Binding MinutesList}" ItemStringFormat="{}{0:00}" SelectedIndex="0"/>
                    <TextBlock Text="s" Foreground="#9BB4D8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TmDisplay" Grid.Row="1" Text="00:05:00"
                           FontFamily="Consolas" FontSize="46" Foreground="White"
                           TextAlignment="Center" Margin="0,6,0,16"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="TmStartPause" Content="Start" Width="100" Height="38" Margin="0,0,10,0"
                            Click="TmStartPause_Click"/>
                    <Button x:Name="TmReset" Content="Reset" Width="100" Height="38"
                            Click="TmReset_Click" IsEnabled="False"/>
                </StackPanel>

                <TextBlock x:Name="TmDoneText" Grid.Row="3" Text="⏰  Time's up!"
                           FontFamily="Segoe UI Semibold" FontSize="22" Foreground="#E5484D"
                           TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
