<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the standard Windows colour picker (System.Windows.Forms.ColorDialog).
         The implicit WinForms/Drawing usings are suppressed because they make
         Color, Brush and UserControl ambiguous against their WPF counterparts;
         the two ColorDialog call sites use fully qualified names instead. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClockWidg</AssemblyName>
    <RootNamespace>ClockWidg</RootNamespace>
    <ApplicationIcon>ClockWidg.ico</ApplicationIcon>
    <!-- Bumped automatically by .githooks/pre-commit; do not edit by hand. -->
    <Version>1.2.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
