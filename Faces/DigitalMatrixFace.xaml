<UserControl x:Class="ClockWidg.Faces.DigitalMatrixFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Border x:Name="Panel" Background="Black" CornerRadius="16" Margin="8">
        <Viewbox Stretch="Uniform" Margin="14">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="Line1" FontFamily="Courier New" FontSize="32"
                           Foreground="#00FF41" Margin="0,2"/>
                <TextBlock x:Name="Line2" FontFamily="Courier New" FontSize="18"
                           Foreground="#00BB30" Margin="0,2"/>
                <TextBlock x:Name="Line3" FontFamily="Courier New" FontSize="18"
                           Foreground="#007A1E" Margin="0,2"/>
            </StackPanel>
        </Viewbox>
    </Border>
</UserControl>
