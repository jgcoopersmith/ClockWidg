<UserControl x:Class="ClockWidg.Faces.DigitalMatrixFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Background="Black">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0">
            <TextBlock x:Name="Line1" FontFamily="Courier New" FontSize="32"
                       Foreground="#00FF41" Margin="0,2"/>
            <TextBlock x:Name="Line2" FontFamily="Courier New" FontSize="18"
                       Foreground="#00BB30" Margin="0,2"/>
            <TextBlock x:Name="Line3" FontFamily="Courier New" FontSize="18"
                       Foreground="#007A1E" Margin="0,2"/>
        </StackPanel>
    </Grid>
</UserControl>
