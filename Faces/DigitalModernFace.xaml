<UserControl x:Class="ClockWidg.Faces.DigitalModernFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Panel" Background="#1e1e2e" CornerRadius="16">
            <Viewbox Stretch="Uniform" Margin="18,14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" FontFamily="Segoe UI Light" FontSize="52"
                               Foreground="White" TextAlignment="Center"/>
                    <TextBlock x:Name="DateText" FontFamily="Segoe UI" FontSize="14"
                               Foreground="#9999BB" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
