<Window x:Class="ClockWidg.AlarmRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm"
        Width="380" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClockWidg;component/Themes/WidgetTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="8" CornerRadius="14" Background="{StaticResource WidgetBgBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="22" Background="Transparent" MouseLeftButtonDown="Content_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="⏰  ALARM" FontFamily="Segoe UI Semibold"
                       FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="NameText" Grid.Row="1" FontFamily="Segoe UI"
                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TimeText" Grid.Row="2" FontFamily="Segoe UI Light"
                       FontSize="40" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SnoozeButton" Content="Snooze 9 min" Width="120" Height="38"
                        Margin="0,0,10,0" Click="Snooze_Click"/>
                <Button x:Name="DismissButton" Content="Dismiss" Width="100" Height="38"
                        Background="{StaticResource AccentBrush}" Click="Dismiss_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
