<Window x:Class="ClockWidg.AlarmRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm"
        Width="360" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#1B2432"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⏰  ALARM" FontFamily="Segoe UI Semibold"
                   FontSize="14" Foreground="#E5484D" Margin="0,0,0,8"/>
        <TextBlock x:Name="NameText" Grid.Row="1" FontFamily="Segoe UI"
                   FontSize="26" FontWeight="Bold" Foreground="White"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="TimeText" Grid.Row="2" FontFamily="Segoe UI Light"
                   FontSize="40" Foreground="#9BB4D8" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SnoozeButton" Content="Snooze 9 min" Width="120" Height="36"
                    Margin="0,0,10,0" Click="Snooze_Click"/>
            <Button x:Name="DismissButton" Content="Dismiss" Width="100" Height="36"
                    Click="Dismiss_Click"/>
        </StackPanel>
    </Grid>
</Window>
